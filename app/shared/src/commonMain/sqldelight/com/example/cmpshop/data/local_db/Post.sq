CREATE TABLE PostEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    userId INTEGER NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL
);

selectAll:
SELECT *
FROM PostEntity
ORDER BY id;

selectPosts:
 SELECT *
 FROM PostEntity
 ORDER BY id
 LIMIT ? OFFSET ?;

insertPost:
INSERT OR REPLACE INTO PostEntity (
    id,
    userId,
    title,
    body
)
VALUES (?, ?, ?, ?);

deleteAll:
DELETE FROM PostEntity;